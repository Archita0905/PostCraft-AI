# Copy this file to backend/.env (same folder as server.py) and fill in your own values.
# Never commit backend/.env: it holds secrets. Restart the backend after editing it.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="postcraft"
CORS_ORIGINS="*"

# AI provider (see backend/services/llm.py)
LLM_PROVIDER_ENDPOINT="gemini"
LLM_MODEL="gemini-3-flash-preview"
# Your own Google Gemini API key (https://aistudio.google.com/apikey). This is all you need.
LLM_API_KEY=""
# Optional: Emergent universal key. Only used when LLM_API_KEY is empty, and it also needs
# the optional `emergentintegrations` package (see the note in requirements.txt).
EMERGENT_LLM_KEY=""
